# Copie para `.env` (mesma pasta do docker-compose.yml) e ajuste os valores.
# Sem este arquivo o compose usa padroes de desenvolvimento. JWT_SECRET e as
# senhas ficam vazios por padrao: o backend usa valores de dev, mas recusa
# subir com NODE_ENV=production enquanto eles nao forem definidos.

POSTGRES_DB=acessstack
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
BACKEND_PORT=3001
FRONTEND_PORT=5173

NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGINS=http://localhost:5173

# Usuarios iniciais criados pelo seed. Em NODE_ENV=production as senhas sao
# obrigatorias. Elas so sao gravadas na criacao do usuario; trocar aqui
# depois nao altera a senha de quem ja existe.
ADMIN_EMAIL=admin@acessstack.local
ADMIN_PASSWORD=
MASTER_EMAIL=owner@acessstack.local
MASTER_PASSWORD=
GATE_EMAIL=operator@acessstack.local
GATE_PASSWORD=
SCANNER_EMAIL=scanner@acessstack.local
SCANNER_PASSWORD=
GOVERNANCE_EMAIL=governance@acessstack.local
GOVERNANCE_PASSWORD=

GATE_START_HOUR=0
GATE_END_HOUR=23
